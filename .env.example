# Processing backend: auto, classic, or deep.
# auto uses deep MindSpore models when available, otherwise falls back to classic.
CRSR_BACKEND=auto

# Classic backend settings.
CRSR_SCALE=2
CRSR_INPAINT_RADIUS=3
CRSR_INPAINT_METHOD=telea
CRSR_SHARPEN_STRENGTH=0.15

# Deep backend settings.
CRSR_DEVICE_TARGET=CPU
CRSR_INPUT_SIZE=512
CRSR_TIMES=8
CRSR_CRA_CKPT=
CRSR_SRGAN_CKPT=

# Output directory.
CRSR_OUTPUT_DIR=combined_repair_sr2.0/output
