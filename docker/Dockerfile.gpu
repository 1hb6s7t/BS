FROM nvidia/cuda:11.6.2-cudnn8-devel-ubuntu20.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PROJECT_DIR=/workspace/bs

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      fonts-dejavu-core \
      python3 \
      python3-distutils \
      python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install mindspore==2.0.0 Pillow==9.5.0 opencv-python-headless==4.10.0.84

WORKDIR /workspace/bs

COPY docker/entrypoint.sh /usr/local/bin/bs-entrypoint
COPY docker/gpu_demo_runner.py /usr/local/bin/bs-gpu-demo-runner.py
RUN chmod +x /usr/local/bin/bs-entrypoint /usr/local/bin/bs-gpu-demo-runner.py

ENTRYPOINT ["/usr/local/bin/bs-entrypoint"]
CMD ["gpu-demo"]
